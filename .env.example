# SeatSurge Environment Variables
PORT=4000
NODE_ENV=development

# Persistent Database (PostgreSQL)
# When PostgreSQL is active, SeatSurge connects to it.
# If PostgreSQL is not reachable, SeatSurge automatically uses its embedded persistent ACID storage engine.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seatsurge
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=seatsurge

# Redis Distributed Coordination
# When Redis is active, SeatSurge coordinates through it.
# If Redis is not reachable, SeatSurge seamlessly uses its atomic in-memory Redis engine.
REDIS_URL=redis://127.0.0.1:6379

# JWT Secret & Session Security
JWT_SECRET=seatsurge_super_secret_jwt_key_walnut_wood_2026
JWT_EXPIRES_IN=24h

# Flash-Sale & Seat Hold Configuration
SEAT_HOLD_DURATION_SECONDS=300
QUEUE_MAX_CONCURRENT_USERS=5
QUEUE_ADMISSION_BATCH_SIZE=2
QUEUE_ADMISSION_INTERVAL_MS=10000

# Bot Detection Sensitivity (0-100 threshold for captcha challenge)
BOT_CHALLENGE_THRESHOLD=60
BOT_BLOCK_THRESHOLD=80
